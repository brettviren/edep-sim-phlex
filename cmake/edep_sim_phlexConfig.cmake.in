@PACKAGE_INIT@

# edep_sim_phlexConfig.cmake
#
# Locate the edep_sim_phlex shared library and headers via:
#   find_package(edep_sim_phlex REQUIRED)
#   target_link_libraries(my_target PRIVATE edep_sim_phlex::edep_sim_phlex)

include(CMakeFindDependencyMacro)
# spdlog / TBB / fmt must be found BEFORE phlex: phlexConfig.cmake does not
# find_dependency() them itself but phlexTargets.cmake references their imported
# targets (see this package's CMakeLists.txt for the full explanation).
find_dependency(Boost REQUIRED COMPONENTS json)
find_dependency(TBB REQUIRED)
find_dependency(spdlog REQUIRED)
find_dependency(fmt REQUIRED)
find_dependency(phlex REQUIRED)
find_dependency(Geant4 REQUIRED)
find_dependency(EDepSim REQUIRED)
find_dependency(HepMC3 REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/edep_sim_phlexTargets.cmake")

check_required_components(edep_sim_phlex)
